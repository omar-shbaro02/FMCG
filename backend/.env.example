ENVIRONMENT=development
DATABASE_URL=sqlite:///./fmcg_cases.db
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000
SECRET_KEY=local-development-secret-key-please-change
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=development-admin-only
FORECAST_ADAPTER=mock
TIMESFM_MODEL_ID=google/timesfm-2.5-200m-pytorch
TIMESFM_CONTEXT_LENGTH=1024
TIMESFM_HORIZON=6
TIMESFM_BATCH_SIZE=16
TIMESFM_DEVICE=cpu
TIMESFM_TIMEOUT_SECONDS=120
TIMESFM_QUANTILE_LOWER_INDEX=1
TIMESFM_QUANTILE_UPPER_INDEX=9
UPLOAD_DIRECTORY=./var/uploads
MAX_UPLOAD_BYTES=20971520
MINIMUM_HISTORY_WEEKS=12
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
