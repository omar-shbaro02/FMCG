ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://fmcg:fmcg@database:5432/fmcg
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=http://localhost:3000
SECRET_KEY=replace-with-at-least-32-random-characters
FORECAST_ADAPTER=mock
TIMESFM_MODEL_ID=google/timesfm-2.5-200m-pytorch
TIMESFM_CONTEXT_LENGTH=1024
TIMESFM_HORIZON=6
TIMESFM_BATCH_SIZE=16
TIMESFM_DEVICE=cpu
TIMESFM_TIMEOUT_SECONDS=120
TIMESFM_QUANTILE_LOWER_INDEX=1
TIMESFM_QUANTILE_UPPER_INDEX=9
# Leave NEXT_PUBLIC_API_URL empty to use the frontend's same-origin /api proxy.
NEXT_PUBLIC_API_URL=
UPLOAD_DIRECTORY=/app/var/uploads
MAX_UPLOAD_BYTES=20971520
MINIMUM_HISTORY_WEEKS=12
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
